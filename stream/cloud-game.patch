+// SaveStateAs writes the current state to RetroMate's library, zip-compressed (a Wii state is ~100 MB raw), through a
+// temporary file so a half-written state never shows up in the list (RetroMate).
+func (f *Frontend) SaveStateAs(name string) error {
+	path, err := f.statePath(name)
+	if err != nil {
+		return err
+	}
+	f.mu.Lock()
+	ss, err := nanoarch.SaveState()
+	f.mu.Unlock()
+	if err != nil {
+		return err
+	}
+	z, err := zip.Compress(ss, name)
+	if err != nil {
+		return err
+	}
+	if err := stdos.MkdirAll(f.statesDir, 0755); err != nil {
+		return err
+	}
+	if err := stdos.WriteFile(path+".tmp", z, 0644); err != nil {
+		return err
+	}
+	return stdos.Rename(path+".tmp", path)
+}
+
