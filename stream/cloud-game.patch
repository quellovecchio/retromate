+package nanoarch
+
+// RetroMate: the core's own options, as the core declares them through the libretro API (any core, any console), so
+// that a client can list them and change them while the game runs. A changed value reaches the core through
+// GET_VARIABLE_UPDATE; whether it applies at once or at the next start is up to the core.
+
+/*
+#include "libretro.h"
+*/
+import "C"
+
+import (
+	"cmp"
+	"fmt"
+	"slices"
+	"strings"
+	"unsafe"
+)
+
+type CoreOptionValue struct {
+	Value string `json:"value"`
+	Label string `json:"label"`
+}
+
+type CoreOption struct {
+	Key      string            `json:"key"`
+	Label    string            `json:"label"`
+	Category string            `json:"category,omitempty"`
+	Values   []CoreOptionValue `json:"values"`
+	Default  string            `json:"default"` // the core config's value if it sets one, else the core's own
+	Value    string            `json:"value"`
+	Hidden   bool              `json:"hidden,omitempty"` // the core says it doesn't apply now (SET_CORE_OPTIONS_DISPLAY)
+}
+
+type CoreOptionCategory struct {
+	Key   string `json:"key"`
+	Label string `json:"label"`
+}
+
+// CoreDevice: a controller the core can emulate on a port (SET_CONTROLLER_INFO), e.g. Dolphin's "WiiMote + Nunchuk".
+type CoreDevice struct {
+	ID    uint   `json:"id"`
+	Label string `json:"label"`
+}
+
+// DeviceKey isn't a core option: it names port 1's device (one of CoreOptions.Devices), so that it travels like one,
+// in the start request and through SetOption, and is saved with the game's options.
+const DeviceKey = "retromate_device"
+
+type CoreOptions struct {
+	Categories []CoreOptionCategory `json:"categories,omitempty"`
+	Options    []CoreOption         `json:"options"`
+	Devices    []CoreDevice         `json:"devices,omitempty"`
+	Device     uint                 `json:"device"`
+}
+
+func cstr(p *C.char) string {
+	if p == nil {
+		return ""
+	}
+	return C.GoString(p)
+}
+
+// each walks a C array terminated by an element whose key is NULL.
+func each[T any](first *T, end func(*T) bool, fn func(*T)) {
+	if first == nil {
+		return
+	}
+	for p := first; !end(p); p = (*T)(unsafe.Add(unsafe.Pointer(p), unsafe.Sizeof(*p))) {
+		fn(p)
+	}
+}
+
+func coreValues(vs []C.struct_retro_core_option_value) (out []CoreOptionValue) {
+	for _, v := range vs {
+		if v.value == nil {
+			break
+		}
+		value := cstr(v.value)
+		out = append(out, CoreOptionValue{Value: value, Label: cmp.Or(cstr(v.label), value)})
+	}
+	return
+}
+
+// declareVariables: API v0, "Description; default|other|...".
+func declareVariables(vars *C.struct_retro_variable) {
+	var opts []CoreOption
+	each(vars, func(v *C.struct_retro_variable) bool { return v.key == nil }, func(v *C.struct_retro_variable) {
+		desc, list, _ := strings.Cut(cstr(v.value), "; ")
+		o := CoreOption{Key: cstr(v.key), Label: desc}
+		for _, s := range strings.Split(list, "|") {
+			o.Values = append(o.Values, CoreOptionValue{Value: s, Label: s})
+		}
+		o.Default = o.Values[0].Value
+		opts = append(opts, o)
+	})
+	Nan0.declared, Nan0.categories = opts, nil
+}
+
+// declareV1: API v1 (SET_CORE_OPTIONS, and the English half of SET_CORE_OPTIONS_INTL).
+func declareV1(defs *C.struct_retro_core_option_definition) {
+	var opts []CoreOption
+	each(defs, func(d *C.struct_retro_core_option_definition) bool { return d.key == nil },
+		func(d *C.struct_retro_core_option_definition) {
+			opts = append(opts, CoreOption{Key: cstr(d.key), Label: cstr(d.desc), Values: coreValues(d.values[:]),
+				Default: cstr(d.default_value)})
+		})
+	Nan0.declared, Nan0.categories = opts, nil
+}
+
+// declareV2: API v2, with categories (SET_CORE_OPTIONS_V2, and the English half of its INTL variant).
+func declareV2(o *C.struct_retro_core_options_v2) {
+	if o == nil {
+		return
+	}
+	var cats []CoreOptionCategory
+	each(o.categories, func(c *C.struct_retro_core_option_v2_category) bool { return c.key == nil },
+		func(c *C.struct_retro_core_option_v2_category) {
+			cats = append(cats, CoreOptionCategory{Key: cstr(c.key), Label: cstr(c.desc)})
+		})
+	var opts []CoreOption
+	each(o.definitions, func(d *C.struct_retro_core_option_v2_definition) bool { return d.key == nil },
+		func(d *C.struct_retro_core_option_v2_definition) {
+			cat := cstr(d.category_key)
+			label := cstr(d.desc)
+			if cat != "" {
+				label = cmp.Or(cstr(d.desc_categorized), label)
+			}
+			opts = append(opts, CoreOption{Key: cstr(d.key), Label: label, Category: cat,
+				Values: coreValues(d.values[:]), Default: cstr(d.default_value)})
+		})
+	Nan0.declared, Nan0.categories = opts, cats
+}
+
+// setDisplay: SET_CORE_OPTIONS_DISPLAY, the core showing or hiding an option.
+func setDisplay(d *C.struct_retro_core_option_display) {
+	if d == nil {
+		return
+	}
+	key := cstr(d.key)
+	for i := range Nan0.declared {
+		if Nan0.declared[i].Key == key {
+			Nan0.declared[i].Hidden = !bool(d.visible)
+		}
+	}
+}
+
+// CoreOptions lists the options the core declared, each with the value it runs with now.
+func (n *Nanoarch) CoreOptions() CoreOptions {
+	opts := slices.Clone(n.declared)
+	for i := range opts {
+		if v, ok := n.meta.Options[opts[i].Key]; ok {
+			opts[i].Default = v
+		}
+		opts[i].Value = opts[i].Default
+		if v, ok := n.options[opts[i].Key]; ok {
+			opts[i].Value = strings.TrimRight(v, "\x00") // GET_VARIABLE keeps them NUL-terminated
+		}
+	}
+	return CoreOptions{Categories: n.categories, Options: opts, Devices: n.devices, Device: n.device}
+}
+
+// SetOption changes one option of the running core; only declared options and values are taken.
+func (n *Nanoarch) SetOption(key, value string) error {
+	if key == DeviceKey {
+		return n.setDevice(value)
+	}
+	i := slices.IndexFunc(n.declared, func(o CoreOption) bool { return o.Key == key })
+	if i < 0 || !slices.ContainsFunc(n.declared[i].Values, func(v CoreOptionValue) bool { return v.Value == value }) {
+		return fmt.Errorf("unknown core option %s=%s", key, value)
+	}
+	if n.options == nil {
+		n.options = map[string]string{}
+	}
+	n.options[key] = value
+	n.optionsChanged.Store(true)
+	return nil
+}
diff --git a/pkg/worker/caged/libretro/nanoarch/vk.h b/pkg/worker/caged/libretro/nanoarch/vk.h
new file mode 100644
index 0000000..03cdaaf
--- /dev/null
+++ b/pkg/worker/caged/libretro/nanoarch/vk.h
@@ -0,0 +1,21 @@
+#ifndef RETROMATE_VK_H
+#define RETROMATE_VK_H
+
+// RetroMate: libretro's Vulkan frontend side (vulkan.c), for cores whose config lists the "vulkan" hack.
+
+#include <stdbool.h>
+
+// Whether a Vulkan GPU is there (cached). Software devices (lavapipe) only with RETROMATE_VULKAN_CPU set.
+bool vk_available(void);
+// The core's context negotiation interface (SET_HW_RENDER_CONTEXT_NEGOTIATION_INTERFACE), or NULL.
+void vk_set_negotiation(const void *iface);
+// Instance, device and queue, through the core's negotiation interface when it gave one. NULL or an error.
+const char *vk_create(void);
+// struct retro_hw_render_interface_vulkan * for GET_HW_RENDER_INTERFACE, NULL before vk_create.
+const void *vk_interface(void);
+const char *vk_device_name(void);
+// The image the core last handed over, copied into host memory as XRGB8888 rows of w * 4 bytes. NULL on failure.
+void *vk_readback(unsigned w, unsigned h);
+void vk_destroy(void);
+
+#endif
diff --git a/pkg/worker/caged/libretro/nanoarch/vulkan.c b/pkg/worker/caged/libretro/nanoarch/vulkan.c
new file mode 100644
index 0000000..adcfee8
--- /dev/null
+++ b/pkg/worker/caged/libretro/nanoarch/vulkan.c
@@ -0,0 +1,440 @@
+// RetroMate: the frontend side of libretro's Vulkan rendering, which cloud-game lacked (it only hosted OpenGL).
+// Headless: no surface, no swapchain. The core renders on our device (created through its context negotiation
+// interface when it has one, so it gets the extensions and features it needs) and hands each frame over with
+// set_image; video_refresh(RETRO_HW_FRAME_BUFFER_VALID) then copies that image into host memory for the encoder.
+// One frame in flight: the copy is waited for before video_refresh returns, so sync index 0 is always free again.
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "libretro_vulkan.h"
+#include "vk.h"
+
+#define MAX_SEMAPHORES 16
+#define MAX_COMMANDS 16
+
+static struct {
+    const struct retro_hw_render_context_negotiation_interface_vulkan *neg;
+    struct retro_hw_render_interface_vulkan iface;
+    VkInstance instance;
+    VkPhysicalDevice gpu;
+    VkDevice device;
+    bool core_device; // created by the core's negotiation interface: its destroy_device runs before ours
+    VkQueue queue;
+    uint32_t family;
+    char name[VK_MAX_PHYSICAL_DEVICE_NAME_SIZE];
+
+    // what the core handed over for the next frame
+    struct retro_vulkan_image image;
+    bool has_image;
+    uint32_t num_wait;
+    VkSemaphore wait[MAX_SEMAPHORES];
+    VkPipelineStageFlags wait_stages[MAX_SEMAPHORES];
+    uint32_t num_cmd;
+    VkCommandBuffer core_cmd[MAX_COMMANDS];
+    VkSemaphore signal;
+
+    // the copy into host memory
+    VkCommandPool pool;
+    VkCommandBuffer cmd;
+    VkFence fence;
+    VkBuffer buf;
+    VkDeviceMemory mem;
+    VkDeviceSize size;
+    void *map;
+    bool coherent;
+} vk;
+
+static pthread_mutex_t queue_lock = PTHREAD_MUTEX_INITIALIZER;
+
+// ---- retro_hw_render_interface_vulkan
+
+static void set_image(void *h, const struct retro_vulkan_image *image, uint32_t num, const VkSemaphore *sems,
+                      uint32_t src_family) {
+    (void)h; (void)src_family; // the core renders on our queue family: no ownership transfer
+    if (!image) { // retracted: the core is about to destroy it (LRPS2 does on close)
+        vk.has_image = false;
+        vk.num_wait = 0;
+        return;
+    }
+    vk.image = *image;
+    vk.has_image = true;
+    vk.num_wait = num > MAX_SEMAPHORES ? MAX_SEMAPHORES : num;
+    for (uint32_t i = 0; i < vk.num_wait; i++) {
+        vk.wait[i] = sems[i];
+        vk.wait_stages[i] = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+    }
+}
+
+static uint32_t get_sync_index(void *h) { (void)h; return 0; }
+static uint32_t get_sync_index_mask(void *h) { (void)h; return 1; }
+
+static void set_command_buffers(void *h, uint32_t num, const VkCommandBuffer *cmd) {
+    (void)h;
+    vk.num_cmd = !cmd ? 0 : num > MAX_COMMANDS ? MAX_COMMANDS : num;
+    if (vk.num_cmd) memcpy(vk.core_cmd, cmd, vk.num_cmd * sizeof(*cmd));
+}
+
+static void wait_sync_index(void *h) { (void)h; } // vk_readback waits for every frame
+static void lock_queue(void *h) { (void)h; pthread_mutex_lock(&queue_lock); }
+static void unlock_queue(void *h) { (void)h; pthread_mutex_unlock(&queue_lock); }
+static void set_signal_semaphore(void *h, VkSemaphore s) { (void)h; vk.signal = s; }
+
+// ---- device
+
+static int type_score(VkPhysicalDeviceType t) {
+    switch (t) {
+    case VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU: return 4;
+    case VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU: return 3;
+    case VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU: return 2;
+    case VK_PHYSICAL_DEVICE_TYPE_CPU: return 1;
+    default: return 0;
+    }
+}
+
+// The best GPU: discrete first. A CPU device (lavapipe) is slower than OpenGL on the same machine: only on request.
+static VkPhysicalDevice pick_gpu(VkInstance instance, char *name) {
+    VkPhysicalDevice devs[16];
+    uint32_t n = 16;
+    if (vkEnumeratePhysicalDevices(instance, &n, devs) < 0) return VK_NULL_HANDLE;
+    VkPhysicalDevice best = VK_NULL_HANDLE;
+    int best_score = 0;
+    bool cpu = getenv("RETROMATE_VULKAN_CPU") != NULL;
+    for (uint32_t i = 0; i < n; i++) {
+        VkPhysicalDeviceProperties p;
+        vkGetPhysicalDeviceProperties(devs[i], &p);
+        int s = type_score(p.deviceType);
+        if (s == 1 && !cpu) continue;
+        if (s > best_score) {
+            best = devs[i];
+            best_score = s;
+            if (name) memcpy(name, p.deviceName, VK_MAX_PHYSICAL_DEVICE_NAME_SIZE);
+        }
+    }
+    return best;
+}
+
+bool vk_available(void) {
+    static int cached = -1;
+    if (cached >= 0) return cached;
+    cached = 0;
+    VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO, .apiVersion = VK_API_VERSION_1_1};
+    VkInstanceCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .pApplicationInfo = &app};
+    VkInstance instance;
+    if (vkCreateInstance(&ci, NULL, &instance) == VK_SUCCESS) {
+        cached = pick_gpu(instance, NULL) != VK_NULL_HANDLE;
+        vkDestroyInstance(instance, NULL);
+    }
+    return cached;
+}
+
+void vk_set_negotiation(const void *iface) { vk.neg = iface; }
+
+static VkInstance create_instance_wrapper(void *opaque, const VkInstanceCreateInfo *ci) {
+    (void)opaque;
+    VkInstance i = VK_NULL_HANDLE;
+    return vkCreateInstance(ci, NULL, &i) == VK_SUCCESS ? i : VK_NULL_HANDLE;
+}
+
+static VkDevice create_device_wrapper(VkPhysicalDevice gpu, void *opaque, const VkDeviceCreateInfo *ci) {
+    (void)opaque;
+    VkDevice d = VK_NULL_HANDLE;
+    return vkCreateDevice(gpu, ci, NULL, &d) == VK_SUCCESS ? d : VK_NULL_HANDLE;
+}
+
+// A device of our own for cores without negotiation: one graphics queue, every core feature the GPU has.
+static bool create_own_device(void) {
+    VkQueueFamilyProperties fams[16];
+    uint32_t n = 16;
+    vkGetPhysicalDeviceQueueFamilyProperties(vk.gpu, &n, fams);
+    uint32_t family = UINT32_MAX;
+    for (uint32_t i = 0; i < n && family == UINT32_MAX; i++)
+        if ((fams[i].queueFlags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)) ==
+            (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT))
+            family = i;
+    if (family == UINT32_MAX) return false;
+    float prio = 1.0f;
+    VkDeviceQueueCreateInfo q = {.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+                                 .queueFamilyIndex = family, .queueCount = 1, .pQueuePriorities = &prio};
+    VkPhysicalDeviceFeatures features;
+    vkGetPhysicalDeviceFeatures(vk.gpu, &features);
+    VkDeviceCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, .queueCreateInfoCount = 1,
+                             .pQueueCreateInfos = &q, .pEnabledFeatures = &features};
+    if (vkCreateDevice(vk.gpu, &ci, NULL, &vk.device) != VK_SUCCESS) return false;
+    vkGetDeviceQueue(vk.device, family, 0, &vk.queue);
+    vk.family = family;
+    return true;
+}
+
+const char *vk_create(void) {
+    const struct retro_hw_render_context_negotiation_interface_vulkan *neg = vk.neg;
+    if (neg && neg->interface_type != RETRO_HW_RENDER_CONTEXT_NEGOTIATION_INTERFACE_VULKAN) neg = NULL;
+
+    VkApplicationInfo def = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO, .pApplicationName = "cloud-game",
+                             .apiVersion = VK_API_VERSION_1_1};
+    const VkApplicationInfo *app = neg && neg->get_application_info ? neg->get_application_info() : NULL;
+    if (!app) app = &def;
+
+    if (neg && neg->interface_version >= 2 && neg->create_instance) {
+        vk.instance = neg->create_instance(vkGetInstanceProcAddr, app, create_instance_wrapper, NULL);
+    } else {
+        VkInstanceCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .pApplicationInfo = app};
+        if (vkCreateInstance(&ci, NULL, &vk.instance) != VK_SUCCESS) vk.instance = VK_NULL_HANDLE;
+    }
+    if (!vk.instance) return "could not create the Vulkan instance";
+    vk.gpu = pick_gpu(vk.instance, vk.name);
+    if (!vk.gpu) return "no Vulkan GPU";
+
+    struct retro_vulkan_context ctx;
+    memset(&ctx, 0, sizeof(ctx));
+    bool ok = false;
+    if (neg && neg->interface_version >= 2 && neg->create_device2)
+        ok = neg->create_device2(&ctx, vk.instance, vk.gpu, VK_NULL_HANDLE, vkGetInstanceProcAddr,
+                                 create_device_wrapper, NULL);
+    else if (neg && neg->create_device)
+        ok = neg->create_device(&ctx, vk.instance, vk.gpu, VK_NULL_HANDLE, vkGetInstanceProcAddr,
+                                NULL, 0, NULL, 0, NULL);
+    if (ok && ctx.device) {
+        vk.core_device = true;
+        if (ctx.gpu) vk.gpu = ctx.gpu;
+        vk.device = ctx.device;
+        vk.queue = ctx.queue;
+        vk.family = ctx.queue_family_index;
+    } else if (!create_own_device()) {
+        return "could not create the Vulkan device";
+    }
+
+    VkCommandPoolCreateInfo pci = {.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+                                   .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+                                   .queueFamilyIndex = vk.family};
+    VkFenceCreateInfo fci = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    if (vkCreateCommandPool(vk.device, &pci, NULL, &vk.pool) != VK_SUCCESS ||
+        vkCreateFence(vk.device, &fci, NULL, &vk.fence) != VK_SUCCESS)
+        return "could not create the copy command pool";
+    VkCommandBufferAllocateInfo ai = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO, .commandPool = vk.pool,
+                                      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY, .commandBufferCount = 1};
+    if (vkAllocateCommandBuffers(vk.device, &ai, &vk.cmd) != VK_SUCCESS) return "could not allocate the copy command";
+
+    vk.iface = (struct retro_hw_render_interface_vulkan){
+        .interface_type = RETRO_HW_RENDER_INTERFACE_VULKAN,
+        .interface_version = RETRO_HW_RENDER_INTERFACE_VULKAN_VERSION,
+        .handle = &vk,
+        .instance = vk.instance,
+        .gpu = vk.gpu,
+        .device = vk.device,
+        .get_device_proc_addr = vkGetDeviceProcAddr,
+        .get_instance_proc_addr = vkGetInstanceProcAddr,
+        .queue = vk.queue,
+        .queue_index = vk.family,
+        .set_image = set_image,
+        .get_sync_index = get_sync_index,
+        .get_sync_index_mask = get_sync_index_mask,
+        .set_command_buffers = set_command_buffers,
+        .wait_sync_index = wait_sync_index,
+        .lock_queue = lock_queue,
+        .unlock_queue = unlock_queue,
+        .set_signal_semaphore = set_signal_semaphore,
+    };
+    if (!vk.name[0]) {
+        VkPhysicalDeviceProperties p;
+        vkGetPhysicalDeviceProperties(vk.gpu, &p);
+        memcpy(vk.name, p.deviceName, VK_MAX_PHYSICAL_DEVICE_NAME_SIZE);
+    }
+    return NULL;
+}
+
+const void *vk_interface(void) { return vk.device ? &vk.iface : NULL; }
+const char *vk_device_name(void) { return vk.name; }
+
+// ---- readback
+
+static uint32_t memory_type(uint32_t bits, VkMemoryPropertyFlags want, VkMemoryPropertyFlags *got) {
+    VkPhysicalDeviceMemoryProperties p;
+    vkGetPhysicalDeviceMemoryProperties(vk.gpu, &p);
+    for (uint32_t i = 0; i < p.memoryTypeCount; i++)
+        if ((bits & (1u << i)) && (p.memoryTypes[i].propertyFlags & want) == want) {
+            *got = p.memoryTypes[i].propertyFlags;
+            return i;
+        }
+    return UINT32_MAX;
+}
+
+static void free_buffer(void) {
+    if (vk.map) vkUnmapMemory(vk.device, vk.mem);
+    if (vk.buf) vkDestroyBuffer(vk.device, vk.buf, NULL);
+    if (vk.mem) vkFreeMemory(vk.device, vk.mem, NULL);
+    vk.map = NULL;
+    vk.buf = VK_NULL_HANDLE;
+    vk.mem = VK_NULL_HANDLE;
+    vk.size = 0;
+}
+
+static bool ensure_buffer(VkDeviceSize size) {
+    if (vk.buf && vk.size >= size) return true;
+    free_buffer();
+    VkBufferCreateInfo bci = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .size = size,
+                              .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT, .sharingMode = VK_SHARING_MODE_EXCLUSIVE};
+    if (vkCreateBuffer(vk.device, &bci, NULL, &vk.buf) != VK_SUCCESS) return false;
+    VkMemoryRequirements req;
+    vkGetBufferMemoryRequirements(vk.device, vk.buf, &req);
+    VkMemoryPropertyFlags flags = 0;
+    // cached host memory: the CPU reads every byte of it, every frame
+    uint32_t type = memory_type(req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT, &flags);
+    if (type == UINT32_MAX)
+        type = memory_type(req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, &flags);
+    if (type == UINT32_MAX) { free_buffer(); return false; }
+    VkMemoryAllocateInfo mai = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .allocationSize = req.size,
+                                .memoryTypeIndex = type};
+    if (vkAllocateMemory(vk.device, &mai, NULL, &vk.mem) != VK_SUCCESS ||
+        vkBindBufferMemory(vk.device, vk.buf, vk.mem, 0) != VK_SUCCESS ||
+        vkMapMemory(vk.device, vk.mem, 0, VK_WHOLE_SIZE, 0, &vk.map) != VK_SUCCESS) {
+        free_buffer();
+        return false;
+    }
+    vk.size = size;
+    vk.coherent = flags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+    return true;
+}
+
+void *vk_readback(unsigned w, unsigned h) {
+    if (!vk.device || !vk.has_image || !w || !h) return NULL;
+    VkDeviceSize size = (VkDeviceSize)w * h * 4;
+    if (!ensure_buffer(size)) return NULL;
+
+    VkImage image = vk.image.create_info.image;
+    VkImageLayout layout = vk.image.image_layout;
+    VkImageSubresourceRange range = vk.image.create_info.subresourceRange;
+    range.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    range.levelCount = 1;
+    range.layerCount = 1;
+
+    VkCommandBufferBeginInfo bi = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+                                   .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT};
+    vkBeginCommandBuffer(vk.cmd, &bi);
+    VkImageMemoryBarrier to_src = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+        .oldLayout = layout,
+        .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .image = image,
+        .subresourceRange = range,
+    };
+    vkCmdPipelineBarrier(vk.cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+                         0, NULL, 0, NULL, 1, &to_src);
+    VkBufferImageCopy region = {
+        .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, range.baseMipLevel, range.baseArrayLayer, 1},
+        .imageExtent = {w, h, 1},
+    };
+    vkCmdCopyImageToBuffer(vk.cmd, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, vk.buf, 1, &region);
+    // back to the layout the core left it in, for its next frame
+    VkImageMemoryBarrier back = to_src;
+    back.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    back.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    back.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    back.newLayout = layout;
+    VkBufferMemoryBarrier host = {
+        .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .buffer = vk.buf,
+        .size = size,
+    };
+    vkCmdPipelineBarrier(vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT | VK_PIPELINE_STAGE_HOST_BIT, 0,
+                         0, NULL, 1, &host, 1, &back);
+    vkEndCommandBuffer(vk.cmd);
+
+    // the core's own command buffers (set_command_buffers) go first, then the copy
+    VkCommandBuffer cmds[MAX_COMMANDS + 1];
+    memcpy(cmds, vk.core_cmd, vk.num_cmd * sizeof(*cmds));
+    cmds[vk.num_cmd] = vk.cmd;
+    VkSubmitInfo si = {
+        .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+        .waitSemaphoreCount = vk.num_wait,
+        .pWaitSemaphores = vk.wait,
+        .pWaitDstStageMask = vk.wait_stages,
+        .commandBufferCount = vk.num_cmd + 1,
+        .pCommandBuffers = cmds,
+        .signalSemaphoreCount = vk.signal ? 1 : 0,
+        .pSignalSemaphores = &vk.signal,
+    };
+    pthread_mutex_lock(&queue_lock);
+    VkResult res = vkQueueSubmit(vk.queue, 1, &si, vk.fence);
+    pthread_mutex_unlock(&queue_lock);
+    vk.num_wait = 0;
+    vk.num_cmd = 0;
+    vk.signal = VK_NULL_HANDLE;
+    if (res != VK_SUCCESS) return NULL;
+    vkWaitForFences(vk.device, 1, &vk.fence, VK_TRUE, UINT64_MAX);
+    vkResetFences(vk.device, 1, &vk.fence);
+    if (!vk.coherent) {
+        VkMappedMemoryRange r = {.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, .memory = vk.mem, .size = VK_WHOLE_SIZE};
+        vkInvalidateMappedMemoryRanges(vk.device, 1, &r);
+    }
+
+    // XRGB8888 is B, G, R, X in memory: BGRA images are already that, RGBA ones swap R and B
+    uint8_t *p = vk.map;
+    switch (vk.image.create_info.format) {
+    case VK_FORMAT_R8G8B8A8_UNORM:
+    case VK_FORMAT_R8G8B8A8_SRGB:
+        for (VkDeviceSize i = 0; i < size; i += 4) {
+            uint8_t r = p[i];
+            p[i] = p[i + 2];
+            p[i + 2] = r;
+        }
+        break;
+    case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+        for (VkDeviceSize i = 0; i < size; i += 4) {
+            uint32_t v;
+            memcpy(&v, p + i, 4);
+            p[i] = (v >> 22) & 0xff;     // B: bits 20-29
+            p[i + 1] = (v >> 12) & 0xff; // G: bits 10-19
+            p[i + 2] = (v >> 2) & 0xff;  // R: bits 0-9
+            p[i + 3] = 0xff;
+        }
+        break;
+    case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+        for (VkDeviceSize i = 0; i < size; i += 4) {
+            uint32_t v;
+            memcpy(&v, p + i, 4);
+            p[i] = (v >> 2) & 0xff;      // B: bits 0-9
+            p[i + 1] = (v >> 12) & 0xff; // G: bits 10-19
+            p[i + 2] = (v >> 22) & 0xff; // R: bits 20-29
+            p[i + 3] = 0xff;
+        }
+        break;
+    case VK_FORMAT_B8G8R8A8_UNORM:
+    case VK_FORMAT_B8G8R8A8_SRGB:
+        break;
+    default: { // copied as is: say so once, the colours will be wrong
+        static VkFormat warned;
+        if (warned != vk.image.create_info.format) {
+            warned = vk.image.create_info.format;
+            fprintf(stderr, "vulkan: frame format %d is not converted to XRGB8888\n", (int)warned);
+        }
+        break;
+    }
+    }
+    return vk.map;
+}
+
+void vk_destroy(void) {
+    if (vk.device) {
+        vkDeviceWaitIdle(vk.device);
+        free_buffer();
+        if (vk.fence) vkDestroyFence(vk.device, vk.fence, NULL);
+        if (vk.pool) vkDestroyCommandPool(vk.device, vk.pool, NULL);
+    }
+    if (vk.core_device && vk.neg && vk.neg->destroy_device) vk.neg->destroy_device();
+    if (vk.device) vkDestroyDevice(vk.device, NULL);
+    if (vk.instance) vkDestroyInstance(vk.instance, NULL);
