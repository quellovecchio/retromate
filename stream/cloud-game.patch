+// setVideoSize updates the appsrc caps when a core changes its frame size without telling the frontend
+// (e.g. LRPS2 rendering 512x448 inside a 640x448 geometry); videoconvertscale then rescales to the output caps.
+static inline void setVideoSize(GstAppSrc *src, guint w, guint h) {
+	GstCaps *old = gst_app_src_get_caps(src);
+	GstCaps *caps = gst_caps_copy(old);
+	gst_caps_unref(old);
+	gst_caps_set_simple(caps, "width", G_TYPE_INT, w, "height", G_TYPE_INT, h, NULL);
+	gst_app_src_set_caps(src, caps);
+	gst_caps_unref(caps);
+}
