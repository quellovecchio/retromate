--- /dev/null
+++ b/pkg/worker/caged/libretro/nanoarch/vulkan.go
@@ -0,0 +1,42 @@
+package nanoarch
+
+// RetroMate: Vulkan cores (vulkan.c). Offered only to cores whose config lists the "vulkan" hack, and only where a
+// Vulkan GPU exists: elsewhere they get OpenGL as before (GET_PREFERRED_HW_RENDER) and a Vulkan request is refused.
+
+/*
+#cgo linux LDFLAGS: -lvulkan
+#include "vk.h"
+*/
+import "C"
+
+import (
+	"errors"
+	"unsafe"
+)
+
+const hackVulkan = "vulkan"
+
+func vulkanOffered() bool { return Nan0.meta.HasHack(hackVulkan) && bool(C.vk_available()) }
+
+func vulkanCreate() error {
+	if e := C.vk_create(); e != nil {
+		return errors.New(C.GoString(e))
+	}
+	Nan0.log.Info().Msgf("Vulkan device: %v", C.GoString(C.vk_device_name()))
+	return nil
+}
+
+func vulkanInterface() unsafe.Pointer { return unsafe.Pointer(C.vk_interface()) }
+
+func vulkanSetNegotiation(iface unsafe.Pointer) { C.vk_set_negotiation(iface) }
+
+// The last frame the core handed over, as XRGB8888 rows of w * 4 bytes, or nil.
+func vulkanReadback(w, h uint) []byte {
+	p := C.vk_readback(C.unsigned(w), C.unsigned(h))
+	if p == nil {
+		return nil
+	}
+	return unsafe.Slice((*byte)(p), w*h*4)
+}
+
+func vulkanDestroy() { C.vk_destroy() }
