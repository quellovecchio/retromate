diff --git a/pkg/worker/caged/libretro/nanoarch/options.go b/pkg/worker/caged/libretro/nanoarch/options.go
new file mode 100644
index 0000000..f5f4fb5
--- /dev/null
+++ b/pkg/worker/caged/libretro/nanoarch/options.go
@@ -0,0 +1,178 @@
+package nanoarch
+
+// RetroMate: the core's own options, as the core declares them through the libretro API (any core, any console), so
+// that a client can list them and change them while the game runs. A changed value reaches the core through
+// GET_VARIABLE_UPDATE; whether it applies at once or at the next start is up to the core.
+
+/*
+#include "libretro.h"
+*/
+import "C"
+
+import (
+	"cmp"
+	"fmt"
+	"slices"
+	"strings"
+	"unsafe"
+)
+
+type CoreOptionValue struct {
+	Value string `json:"value"`
+	Label string `json:"label"`
+}
+
+type CoreOption struct {
+	Key      string            `json:"key"`
+	Label    string            `json:"label"`
+	Category string            `json:"category,omitempty"`
+	Values   []CoreOptionValue `json:"values"`
+	Default  string            `json:"default"` // the core config's value if it sets one, else the core's own
+	Value    string            `json:"value"`
+	Hidden   bool              `json:"hidden,omitempty"` // the core says it doesn't apply now (SET_CORE_OPTIONS_DISPLAY)
+}
+
+type CoreOptionCategory struct {
+	Key   string `json:"key"`
+	Label string `json:"label"`
+}
+
+// CoreDevice: a controller the core can emulate on a port (SET_CONTROLLER_INFO), e.g. Dolphin's "WiiMote + Nunchuk".
+type CoreDevice struct {
+	ID    uint   `json:"id"`
+	Label string `json:"label"`
+}
+
+// DeviceKey isn't a core option: it names port 1's device (one of CoreOptions.Devices), so that it travels like one,
+// in the start request and through SetOption, and is saved with the game's options.
+const DeviceKey = "retromate_device"
+
+type CoreOptions struct {
+	Categories []CoreOptionCategory `json:"categories,omitempty"`
+	Options    []CoreOption         `json:"options"`
+	Devices    []CoreDevice         `json:"devices,omitempty"`
+	Device     uint                 `json:"device"`
+}
+
+func cstr(p *C.char) string {
+	if p == nil {
+		return ""
+	}
+	return C.GoString(p)
+}
+
+// each walks a C array terminated by an element whose key is NULL.
+func each[T any](first *T, end func(*T) bool, fn func(*T)) {
+	if first == nil {
+		return
+	}
+	for p := first; !end(p); p = (*T)(unsafe.Add(unsafe.Pointer(p), unsafe.Sizeof(*p))) {
+		fn(p)
+	}
+}
+
+func coreValues(vs []C.struct_retro_core_option_value) (out []CoreOptionValue) {
+	for _, v := range vs {
+		if v.value == nil {
+			break
+		}
+		value := cstr(v.value)
+		out = append(out, CoreOptionValue{Value: value, Label: cmp.Or(cstr(v.label), value)})
+	}
+	return
+}
+
+// declareVariables: API v0, "Description; default|other|...".
+func declareVariables(vars *C.struct_retro_variable) {
+	var opts []CoreOption
+	each(vars, func(v *C.struct_retro_variable) bool { return v.key == nil }, func(v *C.struct_retro_variable) {
+		desc, list, _ := strings.Cut(cstr(v.value), "; ")
+		o := CoreOption{Key: cstr(v.key), Label: desc}
+		for _, s := range strings.Split(list, "|") {
+			o.Values = append(o.Values, CoreOptionValue{Value: s, Label: s})
+		}
+		o.Default = o.Values[0].Value
+		opts = append(opts, o)
+	})
+	Nan0.declared, Nan0.categories = opts, nil
+}
+
+// declareV1: API v1 (SET_CORE_OPTIONS, and the English half of SET_CORE_OPTIONS_INTL).
+func declareV1(defs *C.struct_retro_core_option_definition) {
+	var opts []CoreOption
+	each(defs, func(d *C.struct_retro_core_option_definition) bool { return d.key == nil },
+		func(d *C.struct_retro_core_option_definition) {
+			opts = append(opts, CoreOption{Key: cstr(d.key), Label: cstr(d.desc), Values: coreValues(d.values[:]),
+				Default: cstr(d.default_value)})
+		})
+	Nan0.declared, Nan0.categories = opts, nil
+}
+
+// declareV2: API v2, with categories (SET_CORE_OPTIONS_V2, and the English half of its INTL variant).
+func declareV2(o *C.struct_retro_core_options_v2) {
+	if o == nil {
+		return
+	}
+	var cats []CoreOptionCategory
+	each(o.categories, func(c *C.struct_retro_core_option_v2_category) bool { return c.key == nil },
+		func(c *C.struct_retro_core_option_v2_category) {
+			cats = append(cats, CoreOptionCategory{Key: cstr(c.key), Label: cstr(c.desc)})
+		})
+	var opts []CoreOption
+	each(o.definitions, func(d *C.struct_retro_core_option_v2_definition) bool { return d.key == nil },
+		func(d *C.struct_retro_core_option_v2_definition) {
+			cat := cstr(d.category_key)
+			label := cstr(d.desc)
+			if cat != "" {
+				label = cmp.Or(cstr(d.desc_categorized), label)
+			}
+			opts = append(opts, CoreOption{Key: cstr(d.key), Label: label, Category: cat,
+				Values: coreValues(d.values[:]), Default: cstr(d.default_value)})
+		})
+	Nan0.declared, Nan0.categories = opts, cats
+}
+
+// setDisplay: SET_CORE_OPTIONS_DISPLAY, the core showing or hiding an option.
+func setDisplay(d *C.struct_retro_core_option_display) {
+	if d == nil {
+		return
+	}
+	key := cstr(d.key)
+	for i := range Nan0.declared {
+		if Nan0.declared[i].Key == key {
+			Nan0.declared[i].Hidden = !bool(d.visible)
+		}
+	}
+}
+
+// CoreOptions lists the options the core declared, each with the value it runs with now.
+func (n *Nanoarch) CoreOptions() CoreOptions {
+	opts := slices.Clone(n.declared)
+	for i := range opts {
+		if v, ok := n.meta.Options[opts[i].Key]; ok {
+			opts[i].Default = v
+		}
+		opts[i].Value = opts[i].Default
+		if v, ok := n.options[opts[i].Key]; ok {
+			opts[i].Value = strings.TrimRight(v, "\x00") // GET_VARIABLE keeps them NUL-terminated
+		}
+	}
+	return CoreOptions{Categories: n.categories, Options: opts, Devices: n.devices, Device: n.device}
+}
+
+// SetOption changes one option of the running core; only declared options and values are taken.
+func (n *Nanoarch) SetOption(key, value string) error {
+	if key == DeviceKey {
+		return n.setDevice(value)
+	}
+	i := slices.IndexFunc(n.declared, func(o CoreOption) bool { return o.Key == key })
+	if i < 0 || !slices.ContainsFunc(n.declared[i].Values, func(v CoreOptionValue) bool { return v.Value == value }) {
+		return fmt.Errorf("unknown core option %s=%s", key, value)
+	}
+	if n.options == nil {
+		n.options = map[string]string{}
+	}
+	n.options[key] = value
+	n.optionsChanged.Store(true)
+	return nil
+}
