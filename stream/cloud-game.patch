+// statesDir is where RetroMate keeps a game's states: library/states/{platform}/{game}, mounted on StatesRoot.
+// game is the path below the library root, as in RetroMate: "ps2/Tekken 5.iso" or "ps2/Tekken 5/disc.iso" (the
+// folder names the game).
+func statesDir(game string) string {
+	parts := strings.Split(filepath.ToSlash(game), "/")
+	name := strings.TrimSuffix(parts[len(parts)-1], filepath.Ext(parts[len(parts)-1]))
+	if len(parts) > 2 {
+		name = parts[1]
+	}
+	return filepath.Join(StatesRoot, parts[0], name)
